* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* FIX: Prevent default scroll */
html,
body {
  overflow: hidden;
  height: 100%;
}

body {
  font-family: 'Montserrat', sans-serif;
  background: #000;
  color: #fff;
}

#root {
  width: 100vw;
  height: 100vh;
}

.custom-cursor {
  position: fixed;
  width: 20px;
  height: 20px;
  border: 2px solid #fff;
  border-radius: 50%;
  pointer-events: none;
  z-index: 9999;
  transition: transform 0.1s ease;
  mix-blend-mode: difference;
}

.custom-cursor.grabbing {
  transform: scale(2);
  border-color: #ffcc00;
  background: rgba(255, 204, 0, 0.3);
}

.custom-cursor.hover {
  transform: scale(1.5);
  border-color: #4ecdc4;
}

.main-nav {
  position: fixed;
  top: 20px;
  right: 20px;
  z-index: 1000;
  display: flex;
  gap: 15px;
}

.nav-btn {
  background: rgba(255, 255, 255, 0.1);
  border: 2px solid #fff;
  color: #fff;
  padding: 0.5rem 1rem;
  cursor: pointer;
  transition: all 0.3s ease;
  font-family: 'Montserrat', sans-serif;
  text-decoration: none;
}

.nav-btn:hover {
  background: rgba(255, 255, 255, 0.2);
}

.section-indicator {
  position: fixed;
  right: 30px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.indicator-dot {
  width: 12px;
  height: 12px;
  border: 2px solid rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  cursor: pointer;
  transition: all 0.3s ease;
}

.indicator-dot.active {
  background: #fff;
  border-color: #fff;
  transform: scale(1.3);
}

.section-counter {
  position: fixed;
  bottom: 30px;
  left: 30px;
  font-size: 0.9rem;
  opacity: 0.6;
  z-index: 1000;
  letter-spacing: 2px;
}

.overlay-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  z-index: 10;
  mix-blend-mode: difference;
}

.name {
  font-size: 4rem;
  font-weight: 700;
  margin-bottom: 1rem;
  letter-spacing: 2px;
}

.title {
  font-size: 1.5rem;
  font-weight: 400;
  letter-spacing: 4px;
  text-transform: uppercase;
}

.title .bold {
  font-weight: 700;
}

.cards-title {
  position: absolute;
  top: 6%;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  z-index: 10;
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: 4px;
  background: linear-gradient(135deg, #fff 0%, #888 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  pointer-events: none;
}

.cards-hint {
  position: absolute;
  bottom: 6%;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  z-index: 10;
  font-size: 0.8rem;
  letter-spacing: 3px;
  text-transform: uppercase;
  opacity: 0.4;
  pointer-events: none;
}

.slider-container {
  position: absolute;
  bottom: 10%;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 2rem;
  z-index: 10;
}

.slider-btn {
  background: rgba(255, 255, 255, 0.1);
  border: 2px solid #fff;
  color: #fff;
  padding: 1rem 2rem;
  cursor: pointer;
  transition: all 0.3s ease;
  font-size: 1.2rem;
}

.slider-btn:hover {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(1.05);
}

.section-content {
  max-width: 1200px;
  margin: 0 auto;
  text-align: center;
  padding: 2rem;
}

.project-categories {
  display: flex;
  justify-content: center;
  gap: 2rem;
  margin-bottom: 3rem;
}

.category-btn {
  background: rgba(255, 255, 255, 0.1);
  border: 2px solid #fff;
  color: #fff;
  padding: 0.8rem 1.5rem;
  cursor: pointer;
  transition: all 0.3s ease;
  font-family: 'Montserrat', sans-serif;
}

.category-btn.active {
  background: rgba(255, 255, 255, 0.3);
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
}

.project-card {
  background: rgba(255, 255, 255, 0.1);
  padding: 2rem;
  border: 1px solid rgba(255, 255, 255, 0.3);
  transition: all 0.3s ease;
  cursor: pointer;
}

.project-card:hover {
  transform: translateY(-5px);
  background: rgba(255, 255, 255, 0.2);
}

.download-btn {
  background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  padding: 1.2rem 3rem;
  border: none;
  font-size: 1.2rem;
  cursor: pointer;
  transition: all 0.3s ease;
  text-decoration: none;
  display: inline-block;
  margin-top: 2rem;
  font-family: 'Montserrat', sans-serif;
}

background: rgba(255, 255, 255, 0.1);
border: 2px solid #fff;
color: #fff;
padding: 0.5rem 1rem;
cursor: pointer;
transition: all 0.3s ease;
font-family: 'Montserrat',
sans-serif;
text-decoration: none;
}

